#25. Merge two DataFrames:

# inner join
# left join
# right join

import pandas as pd
# DataFrame 1
df1 = pd.DataFrame({
    'ID': [1, 2, 3, 4],
    'Name': ['Ram', 'Shyam', 'Mohan', 'Sita']
})

# DataFrame 2
df2 = pd.DataFrame({
    'ID': [3, 4, 5, 6],
    'Marks': [78, 88, 90, 95]
})

inner_join = pd.merge(df1,df2, on='ID',how="inner")
left_join = pd.merge(df1,df2, on='ID',how="left")   ## isse hum koi bhi particular column ko target kar ke concate kr skte h 
right_join = pd.merge(df1,df2, on='ID',how="right")


print(inner_join)
print("-------------------------------------")
print(left_join)
print("-------------------------------------")
print(right_join)


# 26. Concatenate DataFrames:
# row-wise
# column-wise

row_ = pd.concat([df1,df2],axis=0)
column =  pd.concat([df1,df2],axis=1)   ## isme direct concat ho jayega without targeting any column
print(row_)
print(column)


#27. Pivot and melt a DataFrame.
df3 = pd.DataFrame({
    "Name" : ["Satyajit sahu","Ayushi Kumari"],
    "Score" : [10,20],
    "Subject" : ["Science","Commerece"]
})
print(df3)
pivot = df3.pivot_table(index="Name", columns="Subject", values="Score", aggfunc="mean")
print(pivot)
melt = pivot.reset_index().melt(id_vars="Name", var_name="Subject", value_name="Score")
print(melt)



#28. Given student marks:
# find topper
# find average
# count students above average
import pandas as pd
df = pd.read_csv("da.csv")
print(df)


count = df["Name"].count()
marks = df["Marks"].sum()
average = marks / count
print(average)


above_avg = 0
for i in range(len(df)):
    if df["Marks"][i] > average :
        above_avg+=1
print(above_avg)
        


max_= 0 
for i in range(len(df)) :
    if max_ < df["Marks"][i] :
        max_ = df["Marks"][i]
        result = df.loc[i,["Name","Marks", "Subject"]]
print(result)


#29. Gives sales data:
# monthly total sales
#best selling product

import pandas as pd 
df = pd.read_csv("product.csv")
print(df)


total_monthly = df.groupby("Month",as_index=False)[["Sales","Product"]].sum()
print(total_monthly)


best_selling = df.groupby("Product")["Sales"].sum()
print(best_selling)


